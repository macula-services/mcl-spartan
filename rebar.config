%% -*- mode: erlang -*-
%% rebar3 configuration for mcl_spartan.
%%
%% The Spartan Mind: hears the real wire, reasons once about one story, and
%% posts what it made of it to the square. One mind, one endpoint.

{erl_opts, [debug_info, warnings_as_errors]}.

{deps, [
    %% The shared L2 substrate: mesh SDK, realm identity, capabilities, health.
    %% Brings macula (QUIC NIF) transitively. The service module exports no
    %% store_id/0 + data_dir/0, so mcl_om wires the mesh and starts NO
    %% reckon-db: a mind in W1b keeps nothing but its own daily spend, which is
    %% one small file (mind_budget), not an event store. The roster, when it
    %% lands in W5, is what earns one.
    %%
    %% ⚠ A TWO-PART TILDE FLOATS TO THE NEXT MAJOR. `~> 0.39' is not "0.39.x"
    %% but "any 0.x", so it follows whichever 0.x is newest.
    {mcl_om, "~> 0.41"},
    %% THE WIRE, NAMED, so the next mcl_om cannot move it unnoticed: macula 14
    %% is what the live stations speak, 15.0.0-rc is the wire-1.0 island frozen
    %% until 16 Oct, and naming both makes a mcl_om that reaches for macula 15
    %% clash here at resolve time instead of drifting onto it.
    {macula, "~> 14.2"}
]}.

{project_plugins, [rebar3_lint]}.

%% The org's structural ruleset, matching the sibling services.
{elvis, [
    {rulesets, #{
        mcl_min => [
            {elvis_style, no_deep_nesting, #{level => 2}},
            {elvis_style, no_nested_try_catch, #{}},
            {elvis_style, no_if_expression, #{}}
        ]
    }},
    {config, [
        #{files => ["apps/*/src/**/*.erl"], ruleset => mcl_min}
    ]}
]}.

{eunit_opts, [verbose]}.

%% macula reaches this app only through mcl_om, so rebar3 leaves it out of the
%% PLT, and the same is true of the HTTP and TLS applications this service calls
%% directly: jsx for the endpoint's JSON, ssl and public_key for the certificate
%% check. Name them, so calls into each are checked rather than reported as
%% unknown functions.
{dialyzer, [
    {warnings, [unknown]},
    {plt_extra_apps, [macula, mcl_om, jsx, ssl, public_key, inets]}
]}.

{relx, [
    {release, {mcl_spartan, "0.3.1"}, [mcl_spartan, sasl]},
    {sys_config_src, "config/sys.config.src"},
    {vm_args_src,    "config/vm.args.src"},
    {extended_start_script, true}
]}.

{profiles, [
    %% meck stands in for the endpoint and the mesh in the mind's tests, so a
    %% case decides exactly what one reasoning turn was handed and handed back.
    {test, [{deps, [{meck, "~> 1.2"}]}]},
    {prod, [{relx, [{mode, prod},
                    {include_src, false},
                    {include_erts, true},
                    {debug_info, strip}]}]}
]}.
